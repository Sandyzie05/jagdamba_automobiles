{
  "name": "jagdamba-automobiles",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "app.js",
  "engines": {
    "node": "^18.0.0 || >=20.0.0"
  },
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node -e \"var m=process.version.match(/^v([0-9]+)/);if(!m||+m[1]<18){console.error('Node 18+ required. Found: '+process.version);process.exit(1)}\" && tsc -b && node ./node_modules/vite/bin/vite.js build",
    "build:site": "npm run build",
    "lint": "eslint .",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "start": "node app.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "framer-motion": "^12.38.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1"
  }
}
